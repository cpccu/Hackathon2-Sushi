# Production Environment Configuration (for Render Web Service)
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://campusos.vercel.app
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
COOKIE_NAME=session_token
COOKIE_SECRET=super_secret_cookie_signing_key_replace_in_prod
SESSION_MAX_AGE_DAYS=7

# Cloudinary (Required for image uploads: receipts, attachments, posters)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
